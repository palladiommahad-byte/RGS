# Copy to .env.production on the server and fill in every value. Never commit it.
# Random secrets: openssl rand -base64 48

# --- Domains (DNS A records -> this server) ---
DOMAIN=riad.example.com
# Short-lived signed links to private files
FILES_DOMAIN=files.riad.example.com
# For Let's Encrypt expiry notices
ACME_EMAIL=admin@example.com

# --- Database ---
POSTGRES_USER=riad
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=riad

# --- Auth (32+ characters each) ---
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_OTHER_LONG_RANDOM
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Field encryption (passport numbers, CIN) ---
# 32 bytes base64: openssl rand -base64 32
# KEEP A COPY OFF THE SERVER: without it, encrypted fields in backups cannot be read.
FIELD_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64
FIELD_HASH_KEY=CHANGE_ME_LONG_RANDOM

# --- Object storage (MinIO in the stack; these are also its admin credentials) ---
S3_REGION=us-east-1
S3_ACCESS_KEY=riad-storage
S3_SECRET_KEY=CHANGE_ME_LONG_RANDOM
S3_BUCKET_PASSPORTS=riad-passports
S3_BUCKET_RECEIPTS=riad-receipts
S3_BUCKET_DOCUMENTS=riad-documents
SIGNED_URL_TTL_SECONDS=300

# --- Passport OCR (optional; empty = local Tesseract, images never leave the server) ---
GOOGLE_VISION_API_KEY=

# --- Data retention ---
PASSPORT_IMAGE_RETENTION_DAYS=90

# --- Backups ---
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3

# --- First start only: the production seed creates the riad and its owner account ---
SEED_RIAD_NAME=Riad Example
SEED_ROOM_COUNT=8
SEED_OWNER_NAME=Propriétaire
SEED_OWNER_EMAIL=owner@example.com
# 12+ characters; change it after the first login, then delete it from this file
SEED_OWNER_PASSWORD=
