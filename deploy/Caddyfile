# HTTPS certificates are obtained and renewed automatically (Let's Encrypt) for both names.
# No account email needed: Let's Encrypt no longer sends expiry emails and Caddy renews on time.

{
	# RSA key: Let's Encrypt then signs through its long-trusted RSA chain. The newer ECDSA
	# chain (2026 "Root YE") is refused by some iPhones ("This Connection Is Not Private").
	key_type rsa2048
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Camera: passport photos and the staff badge clock.
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	# API (REST + Socket.io under /api/v1/socket.io; WebSocket upgrades pass through).
	handle /api/v1/* {
		request_body {
			max_size 25MB
		}
		reverse_proxy api:4000
	}

	# Staff dashboard and guest check-in pages.
	handle {
		reverse_proxy web:3000
	}
}

# Signed, 5-minute links to private files (passport photos, receipts, contracts).
# The Host header is kept, so MinIO can verify the signature. Downloads only: the API talks
# to MinIO inside Docker, so nothing from the internet may write, list or administer it.
{$FILES_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@read {
		method GET HEAD
		not path /minio/*
		query X-Amz-Signature=*
	}
	handle @read {
		reverse_proxy minio:9000
	}
	handle {
		respond 403
	}
}
