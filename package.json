{
  "name": "riad-management-system",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @riad/shared build && pnpm -r --parallel --filter @riad/api --filter @riad/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "db:up": "docker compose up -d postgres minio",
    "docker:up": "docker compose up -d --build",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @riad/api prisma:migrate",
    "db:seed": "pnpm --filter @riad/api prisma:seed",
    "db:reset": "pnpm --filter @riad/api prisma:reset",
    "test:e2e": "pnpm --filter @riad/api test:e2e",
    "db:seed-demo": "pnpm --filter @riad/api prisma:seed-demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
