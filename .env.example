# Copy to .env (root) — apps/api and apps/web both read it.

# --- Docker host ports ---
POSTGRES_HOST_PORT=5433
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- API ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://riad:riad@localhost:5433/riad?schema=public
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3100

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Set to true in production (HTTPS only cookies)
COOKIE_SECURE=false

# AES-256-GCM key for document_number / cin (32 bytes, base64).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
# Separate key for the searchable HMAC index (any random string, 32+ chars)
FIELD_HASH_KEY=REPLACE_WITH_RANDOM_HASH_KEY

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_PASSPORTS=riad-passports
S3_BUCKET_RECEIPTS=riad-receipts
S3_BUCKET_DOCUMENTS=riad-documents
S3_BUCKET_PUBLIC=riad-public
SIGNED_URL_TTL_SECONDS=300

# --- Passport OCR (optional; Tesseract is used when empty) ---
GOOGLE_VISION_API_KEY=

# --- Data retention ---
PASSPORT_IMAGE_RETENTION_DAYS=90

# --- Seed ---
SEED_RIAD_NAME=Riad Demo
SEED_ROOM_COUNT=8
SEED_DEFAULT_PASSWORD=Demo1234!

# --- Web ---
# Where Next.js proxies /api/v1/* (server side)
API_INTERNAL_URL=http://localhost:4000
# Public address encoded in the printed check-in QR codes (empty = current browser origin)
NEXT_PUBLIC_SITE_URL=
# Socket.io origin for live notifications (empty = same origin, behind the reverse proxy)
NEXT_PUBLIC_SOCKET_URL=
